{
  "name": "@reviewapp/backend",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "uv run uvicorn app.main:app --reload --port 8000",
    "lint": "uv run ruff check . && uv run ruff format --check .",
    "typecheck": "uv run pyright",
    "test": "uv run pytest",
    "openapi": "uv run python -m scripts.export_openapi",
    "migrate": "uv run alembic upgrade head",
    "migration": "uv run alembic revision --autogenerate -m"
  }
}
